#!/bin/sh

BINDIR=$( readlink -f $(dirname $0) )
. $BINDIR/utils.sub
set -o errexit -o pipefail -o noclobber

NAME=${1:-*.patch}

mkdir -p /tmp/buildlogs
find ${SRCDIR}/patches/RESEARCH -name "$NAME" | sort | {
    while read patch; do
        echo Testing $patch

        cd $WRKDIR
        log=/tmp/buildlogs/`basename $patch`.log
	rm -f "$log"*

	{
        echo Extracting perl
        do_extract_perl || exit 1

        cd $PERL_BASE

	if [ -z "$NO_LOCAL_PATCHES" ] && grep -q MANIFEST "$patch"; then
		sed -n 's,^+\(cpan/[^/]*\)/.*$,\1,p' "$patch" | sort -u > "$log.files"
		while read -r f; do
		    [ -e "$SRCDIR/$f" ] &&
		        cp -a "$SRCDIR/$f" "$( dirname "$f" )"
		done < "$log.files"
	fi

        do_patch_perl 2>&1 | tee "$log.do_patch" || exit 1

	grep ^Hunk "$log.do_patch" | grep -qv ' succeeded ' && exit 1

        find . -name '*.orig' -delete

	cp t/porting/customized.dat t/porting/customized.dat.orig.test

        echo Applying $patch
        if ! patch -p0 -f -E -F 10 -Ni "$patch"; then
            echo "Failed"
            find . -name '*.rej' -print -exec cat {} \;
            exit
        fi

       [ $( find . -name '*.rej' | wc -l ) -gt 0 ] &&
            echo "Failed" && exit

        mv -f "$patch" "${patch}.old"

        # In case the patch touched the MANIFEST, make sure it is sorted
	# but ignore errors as we regenerated it.
        perl ./Porting/manisort -o MANIFEST || true

        # Then make sure it is right
        perl ./regen/lib_cleanup.pl -v || true

        if [ -z "$REGEN_PATCHES" ]; then
            do_build_perl || exit

	    chmod u+w t/porting/customized.dat
	    ( [ -d obj ] && cd obj
ls -l
                LD_LIBRARY_PATH=${PWD} \
	        ./perl -It/lib ./t/porting/customized.t --regen || true )
	    mv t/porting/customized.dat.orig.test t/porting/customized.dat.orig
        fi

        echo Generating $new_patch
        new_patch=`echo "$patch" | sed -e "s/RESEARCH/APPLIES/"`
        new_dir=`dirname "$new_patch"`
        mkdir -p "$new_dir"
	rm -f "${new_patch}.new"
	"$BINDIR"/update_patch "$patch.old" > "${new_patch}.new"

        if [ -z "$REGEN_PATCHES" ]; then
            do_test_perl 2>&1 | tee "$log.build" || exit
	fi

        echo Renaming patches
        patch="$new_patch"

        # Did we win?
        if [ -z "$REGEN_PATCHES" ] && test_build_success "$log.build"; then
            new_patch=`echo "$patch" | sed -e "s/APPLIES/GOOD/"`

            new_dir=`dirname "$new_patch"`
            mkdir -p "$new_dir"

            mv -f "${patch}.new" "$new_patch"
            if [ -s "$log.files" ]; then
		while read -r f; do
		    if [ -e "$SRCDIR/$f" ]; then
			t="$SRCDIR/files/$( dirname "$f" )"
			mkdir -p "$t"
		        mv "$SRCDIR/$f" "$t"
                    fi
		done < "$log.files"
            fi
            patch="$new_patch"
        else
            mv -f "${patch}.new" "$patch"
        fi

        echo Patch is now $patch
	} 2>&1 | tee "$log"
    done
}
