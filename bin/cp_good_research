#!/bin/sh

BASEDIR=$( dirname "$( readlink -f "$(dirname $0)" )" )/patches

WRK=${BASEDIR}/GOOD
SRC=${BASEDIR}/GOOD.orig
DST=${BASEDIR}/RESEARCH

if [ ! -e "$SRC" ]; then
	echo "Before using this, 'mv $WRK $SRC'" >&2
	exit 1
fi

find "$SRC" | while read from; do
	[ "$SRC" == "$from" ] && continue
	to="$DST/${from#$SRC/}"
	if [ -d "$from" -a ! -d "$to" ]; then
		mkdir -p "$to"
	elif [ ! -e "$WRK/${from#$SRC/}" ]; then
		echo "$to"
		old="$to.old"
		if [ -e "$old" ]; then
			mv "$old" "$to"
		else
			cp "$from" "$to"
		fi
	fi
done
